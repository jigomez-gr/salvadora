# ─── Base de Datos (PostgreSQL con Prisma) ───
DATABASE_URL="postgresql://usuario:password@localhost:5432/crm_salvadora"

# ─── Conexión al CRM Salvadora (Backend NestJS) ───
# En local: http://localhost:3001
# En producción: https://crm-salvadoraconesa.jigretera.com
NEXT_PUBLIC_CRM_API_URL="https://crm-salvadoraconesa.jigretera.com"
NEXT_PUBLIC_DEFAULT_AGENT_KEY="booking"
NEXT_PUBLIC_BUSINESS_NAME="Centro de Yoga y Bienestar Salvadora Conesa"
NEXT_PUBLIC_ENABLE_ANALIZAIA="N"
PORWASSAP="N"
NEXT_PUBLIC_PORWASSAP="N"
PORVAPI="S"
NEXT_PUBLIC_PORVAPI="S"

# ─── Pasarela de Pagos Stripe (Checkout & Webhook) ───
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Almacenamiento y Sincronización de Medios (Vídeos, Flyers y Documentos) ───
MEDIA_STORAGE_ROOT="d:/tmp/antigraviti/salvadora/media_base"
MEDIA_VIDEOS_DIR="d:/tmp/antigraviti/salvadora/media_base/videos"
MEDIA_DOCUMENTS_DIR="d:/tmp/antigraviti/salvadora/media_base/documentos"
MEDIA_FLYERS_DIR="d:/tmp/antigraviti/salvadora/media_base/flyers"

# Sincronización remota SCP al servidor (opcional)
MEDIA_SYNC_HOST=192.168.1.17
MEDIA_SYNC_USER=root
MEDIA_SYNC_PORT=22
MEDIA_SYNC_REMOTE_PATH=/var/data/salvadora/media
